[Unit]
Description=LiquidityWise (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=liquiditywise
Group=liquiditywise
WorkingDirectory=/opt/liquiditywise
Environment=NODE_ENV=production
Environment=PORT=3200
Environment=HOSTNAME=127.0.0.1
# .env.local is read by Next itself at start; nothing is duplicated here.
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
