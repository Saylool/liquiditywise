[Unit]
Description=LiquidityWise (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=liquiditywise
Group=liquiditywise
WorkingDirectory=/opt/liquiditywise
Environment=NODE_ENV=production
Environment=PORT=3200
# .env.local is read by Next itself at start; nothing is duplicated here.
#
# Loopback only: nginx is the one thing that should reach this. The address is
# a flag because `next start` does not read HOSTNAME — this unit set that
# variable for a month while the application listened on every interface,
# kept off the internet only by the firewall.
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
