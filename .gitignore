# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# The one certificate that belongs here: public, what backups are encrypted to.
# Its private key is never in this repository.
!deploy/backup-recipient.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local editor/tooling config, not project code
.claude/

# Local design instructions, generation masters and review artifacts
/.design/
/10k-websites-skill.zip

# env files
.env*
# ...except the placeholder-only template, which must be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Output of scripts/readLiveExplanations.spec.ts
/explanations.json
/explanations.report.txt
